{
  "manifest_version": 3,
  "name": "Onshape Mitigator",
  "version": "2.0.0",
  "description": "Small Onshape helpers: instant tooltips, collapsible sketch panel, configurable shortcuts, and AI-ready document context.",
  "homepage_url": "https://github.com/philipvibecodes-maker/onshape-mitigator",
  "icons": {
    "16": "icons/mitigator-16.png",
    "32": "icons/mitigator-32.png",
    "48": "icons/mitigator-48.png",
    "128": "icons/mitigator-128.png"
  },
  "action": {
    "default_title": "Toggle Onshape Mitigator menu",
    "default_icon": {
      "16": "icons/mitigator-16.png",
      "32": "icons/mitigator-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.onshape.com/*"],
      "js": ["keyboard-guard.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.onshape.com/*"],
      "js": ["assets/main.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["onshape-page-bridge.js"],
      "matches": ["https://*.onshape.com/*"]
    }
  ],
  "permissions": ["storage", "clipboardWrite"],
  "background": {
    "service_worker": "background.js"
  }
}
